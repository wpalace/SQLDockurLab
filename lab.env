# =============================================================================
# sql-ag-lab configuration. Single source of truth for the lab topology.
# Read by ./lab (bash) and by docker compose (as an env file).
# Changing names/IPs/MACs requires re-running `./lab provision` (the base image
# does NOT need rebuilding: per-VM identity is injected via SMBIOS at first boot).
# Changing RAM/CPU of a VM invalidates its saved memory state (re-provision or
# re-save from a booted lab).
# =============================================================================

# --- Credentials (lab only, never reuse) ------------------------------------
LAB_DOMAIN=lab.local
LAB_NETBIOS=LAB
LAB_PASSWORD=P@ssw0rd!2025
LAB_SQL_SVC_USER=sqlsvc

# --- Media -------------------------------------------------------------------
# SQL Server 2025 Enterprise Developer ISO (SQLServer2025-x64-ENU-EntDev.iso),
# placed in ./media. Windows Server 2025 eval is downloaded by dockur.
LAB_SQL_ISO=SQLServer2025-x64-ENU-EntDev.iso
# Optional: local Windows Server 2025 ISO instead of the dockur download.
# LAB_WIN_ISO=WinServer2025Eval.iso
LAB_DOCKUR_IMAGE=docker.io/dockurr/windows:latest

# --- Storage -----------------------------------------------------------------
# Put this on fast NVMe. A reflink-capable fs (XFS/btrfs) is a bonus, not needed.
LAB_IMAGES_DIR=./images
LAB_MEDIA_DIR=./media
LAB_IMAGE=sql-ag-lab/vm:latest

# --- Networks (two subnets, routed by the 'router' container) ---------------
LAB_NET_A=10.50.0.0/24
LAB_NET_A_HOST=10.50.0.1
LAB_NET_A_ROUTER=10.50.0.254
LAB_NET_A_BRIDGE=labbr-a
LAB_NET_A_BRIDGE_MAC=02:4c:41:42:00:01
LAB_NET_A_ROUTER_MAC=02:4c:41:42:fe:01
LAB_NET_B=10.51.0.0/24
LAB_NET_B_HOST=10.51.0.1
LAB_NET_B_ROUTER=10.51.0.254
LAB_NET_B_BRIDGE=labbr-b
LAB_NET_B_BRIDGE_MAC=02:4c:41:42:00:02
LAB_NET_B_ROUTER_MAC=02:4c:41:42:fe:02
LAB_PREFIX=24
# Optional WAN emulation between the subnets, e.g. "20ms 2ms" (tc netem delay args)
LAB_WAN_DELAY=
# 0 = lab is air-gapped (deterministic; recommended). 1 = VMs can reach the internet via host NAT.
LAB_INTERNET=0

# --- VMs ---------------------------------------------------------------------
# Memory budget for a 32 GB / 8 thread host:
#   DC 2 GB + 4 x 5 GB SQL = 22 GB guest RAM, ~1 GB QEMU overhead, ~9 GB left for host/page cache.
DC1_IP=10.50.0.10
DC1_MAC=52:54:00:4c:00:10
DC1_RAM_MB=2048
DC1_CPUS=1

SQL1_IP=10.50.0.11
SQL1_MAC=52:54:00:4c:00:11
SQL2_IP=10.50.0.12
SQL2_MAC=52:54:00:4c:00:12
SQL3_IP=10.51.0.13
SQL3_MAC=52:54:00:4c:00:13
SQL4_IP=10.51.0.14
SQL4_MAC=52:54:00:4c:00:14
SQL_RAM_MB=5120
SQL_CPUS=2
# SQL Server max/min server memory (MB) on each node.
SQL_MAX_MEMORY_MB=2048
SQL_MIN_MEMORY_MB=512

# Browser (noVNC) console ports for ./lab console (debugging only; Server Core shows a cmd/sconfig window).
LAB_VNC_BIND=127.0.0.1
DC1_VNC_PORT=6111
SQL1_VNC_PORT=6112
SQL2_VNC_PORT=6113
SQL3_VNC_PORT=6114
SQL4_VNC_PORT=6115

# --- Cluster / AG --------------------------------------------------------------
LAB_CLUSTER_NAME=LABCLU
LAB_CLUSTER_IP_A=10.50.0.50
LAB_CLUSTER_IP_B=10.51.0.50
LAB_AG_NAME=LabAG
LAB_LISTENER_NAME=LabAGL
LAB_LISTENER_IP_A=10.50.0.60
LAB_LISTENER_IP_B=10.51.0.60
LAB_LISTENER_PORT=1433
LAB_AG_DATABASE=LabDB
# Replica roles. SQL1+SQL2 (subnet A) sync/automatic, SQL3 (subnet B) sync/manual (DR),
# SQL4 (subnet B) async/manual. Gives automation a realistic mix of states.
LAB_AG_MODES="SQL1:SYNCHRONOUS_COMMIT:AUTOMATIC SQL2:SYNCHRONOUS_COMMIT:AUTOMATIC SQL3:SYNCHRONOUS_COMMIT:MANUAL SQL4:ASYNCHRONOUS_COMMIT:MANUAL"
# Cluster heartbeat thresholds (missed 1s heartbeats). Raised above defaults (10/20)
# so a slightly staggered resume never triggers a failover.
LAB_SAME_SUBNET_THRESHOLD=20
LAB_CROSS_SUBNET_THRESHOLD=40

# --- Runtime behaviour ---------------------------------------------------------
# frozen: guests resume at the wall-clock time of the checkpoint (fully deterministic,
#         eval licences never expire, Kerberos between VMs fine). Host-side Kerberos
#         auth will NOT work (skew); use SQL auth from the host.
# sync:   after resume, set every guest clock to host UTC (in parallel).
LAB_TIME_MODE=frozen
# 1 = guest disk flushes are not fsync'd to host in restore mode (disposable overlays,
#     much faster I/O). Only a host crash can lose data, and the data is throw-away.
LAB_UNSAFE_CACHE=1
# Use QEMU mapped-ram migration format for memory state files (QEMU >= 9.0).
LAB_MAPPED_RAM=1
# Seconds to wait (with CPU idle) before taking the golden checkpoint.
LAB_SETTLE_SECONDS=120
# QEMU CPU model. 'host' is fastest; state files then only restore on the same CPU model/host.
LAB_CPU_MODEL=host
