# Lab VMs. Copy to terraform.tfvars (gitignored) and fill in the values marked REQUIRED.
# Apply the shared root first (deploy/gcp/terraform/shared).

project_id  = "my-gcp-project"          # REQUIRED, same as shared
zone        = "us-central1-a"           # in the shared region
bucket_name = "my-team-sqlag-artifacts" # REQUIRED, output bucket_name of shared

# One or two VMs per team member. Key = "<owner>-<n>"; VM name = "<name_prefix>-<key>".
vms = {
  "bill-1" = { owner = "bill" } # REQUIRED: at least one entry
  # "bill-2"  = { owner = "bill", spot = false }   # standard (non-spot) VM
  # "alice-1" = { owner = "alice" }
  # "ci-1"    = { owner = "ci", publisher = true }   # may write artifacts to the bucket
  # "bill-2"  = { owner = "bill", name = "vm2", source_snapshot = "sqlag-bill-1-snap" }  # clone of a built VM (./lab gcp snapshot bill-1)
}

# Defaults for all VMs (each entry above can override machine_type, min_cpu_platform,
# disk_type, disk_size_gb, image, cpu_model, spot, publisher).
# default_machine_type     = "n2-standard-16"   # 16 vCPU / 64 GB; lab needs >= 9 vCPU / 24 GB
# default_min_cpu_platform = "Intel Ice Lake"   # keep identical on VMs that share checkpoints
# default_disk_type        = "pd-ssd"           # hyperdisk-balanced on N4/C3/C4
# default_disk_size_gb     = 300
# default_image            = "debian-cloud/debian-12"
# default_cpu_model        = "host"
# default_spot             = true               # spot: cheap, may be preempted (VM stops, disk kept)
# public_ip                = false              # IAP only
# timezone                 = "UTC"              # e.g. "America/Los_Angeles" for PT log times
