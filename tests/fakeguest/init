#!/bin/busybox sh
# Fake "Windows" guest for pipeline tests: same NIC/IP/MAC plan, answers on the ports the
# lab health check probes (389 on DC1, 1433 on SQL nodes, 1433 on listener IPs via SQL1).
/bin/busybox --install -s /bin
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev
for m in failover net_failover virtio_net; do insmod /lib/$m.ko; done
for kv in $(cat /proc/cmdline); do case $kv in lab.*=*) k=${kv%%=*}; k=${k#lab.}; eval "LAB_$k=${kv#*=}";; esac; done
sleep 1
ip link set lo up; ip link set eth0 up
ip addr add "$LAB_ip" dev eth0
ip route add default via "$LAB_gw"
case "$LAB_ip" in 10.50.0.11/*) ip addr add 10.50.0.60/24 dev eth0 ;; esac
echo "fakeguest up ip=$LAB_ip gw=$LAB_gw" > /dev/kmsg
# Optional: dirty N MiB of guest RAM (realistic state-file sizes for timing tests).
if [ -n "${LAB_fill:-}" ]; then mkdir -p /fill; mount -t tmpfs -o size=$((LAB_fill + 64))m tmpfs /fill
  dd if=/dev/urandom of=/fill/blob bs=1M count="$LAB_fill" 2>/dev/null; echo "filled ${LAB_fill} MiB" > /dev/kmsg; fi
# Reply with guest uptime so tests can prove the RAM state (not a reboot) was restored.
for port in 389 1433 22; do nc -ll -p $port -e /bin/cat /proc/uptime & done
while true; do sleep 3600; done
